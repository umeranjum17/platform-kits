  "exclude": ["packages/overlay/src/rn.ts", "packages/overlay/src/focused-field.rn.ts", "packages/overlay/src/screen-frame.rn.ts", "packages/statusbar/src/rn.ts", "packages/speak/src/rn.ts"]
}
