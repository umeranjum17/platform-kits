{
  "extends": "./tsconfig.base.json",
  "compilerOptions": { "noEmit": true, "composite": false, "declaration": false },
  "include": ["packages/*/src", "packages/*/test", "packages/test-support.ts", "test-support", "scripts/*.ts"],
